{
  "name": "hexsplitter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node dev-server.js",
    "test": "node --test --test-concurrency=1 --test-timeout=120000",
    "test:unit": "node --test --test-concurrency=1 --test-timeout=60000 tests/*.test.js",
    "test:browser": "node --test --test-concurrency=1 --test-timeout=120000 tests/*.test.mjs"
  },
  "dependencies": {
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
